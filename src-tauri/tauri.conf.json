{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claude-kit",
  "version": "0.4.0",
  "identifier": "com.warshoow.claudekit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "claude-kit",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Warshoow/claude-kit/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3RjYwQzBFODZGRTIzMDgKUldRSUkvNkdEZ3oyZDRrQUQ2eCtSZ3VibldJOUZtdmVET21ERzQ1VU1ud1pTUnhrMVZlMVQ4V0MK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
